# ─────────────────────────────────────────────────────────────
# nSights — environment template
# Copy to .env (local) and set per-service vars in Railway / Vercel.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Database (Neon Postgres, Frankfurt) ──────────────────────
# Pooled connection for app queries
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/nsights?sslmode=require
# Unpooled connection for migrations / RLS transactions
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/nsights?sslmode=require

# ── Auth (Better Auth) ───────────────────────────────────────
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# ── Jobs (BullMQ + Railway Redis) ────────────────────────────
# Railway Redis plugin connection string
REDIS_URL=redis://default:pass@host:6379

# ── Storage (Railway Volume) ─────────────────────────────────
# volume = Railway persistent disk (prod).  's3' reserved for future R2/S3.
STORAGE_DRIVER=volume
# Mount path of the Railway volume on the API/worker service.
STORAGE_DIR=/data/storage

# ── Billing (Stripe) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_BASE=price_xxx   # optional default price

# ── Email (Postmark) ─────────────────────────────────────────
POSTMARK_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EMAIL_FROM=noreply@yourfirm.ie

# ── AI commentary (Vertex AI Gemini, EU region) ──────────────
GOOGLE_VERTEX_PROJECT=your-gcp-project
GOOGLE_VERTEX_LOCATION=europe-west4
GOOGLE_APPLICATION_CREDENTIALS_JSON=
AI_MODEL_ID=gemini-2.0-flash-001

# ── PDF renderer (Railway Playwright service) ────────────────
PDF_RENDERER_URL=http://pdf-renderer.railway.internal:8080
RENDER_TOKEN_SECRET=change-me-openssl-rand-base64-32

# ── Monitoring (Sentry EU) ───────────────────────────────────
SENTRY_DSN=
